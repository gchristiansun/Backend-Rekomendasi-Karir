generator client {
    provider = "prisma-client-js"
}

generator erd {
    provider = "prisma-erd-generator"
  }

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id            String   @id @default(ulid())
    email         String   @unique
    name          String?
    phone         String?
    password      String?
    role          String   @default("student")
    status        String   @default("active")
    refresh_token String?
    created_at    DateTime @default(now())
    updated_at    DateTime @updatedAt

    student          Student?
    companyMember    CompanyMember?
    universityMember UniversityMember?
    notifications    Notification[]
    reviewedCerts    Certificate[]     @relation("CertReviewer")
    postedJobs       Job[]             @relation("JobPostedBy")

    @@index([role])
    @@index([status])
}

model University {
    id         String   @id @default(ulid())
    name       String
    code       String   @unique
    address    String?
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    members  UniversityMember[]
    students Student[]
    courses  Course[]
}

model UniversityMember {
    id           String   @id @default(ulid())
    userId       String   @unique
    universityId String
    position     String   @default("admin_kampus")
    created_at   DateTime @default(now())

    user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

    @@index([universityId])
}

model Student {
    id           String   @id @default(ulid())
    userId       String   @unique
    universityId String?
    nim          String?  @unique
    major        String?
    semester     Int?
    gpa          Float?
    bio          String?
    created_at   DateTime @default(now())
    updated_at   DateTime @updatedAt

    user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    university University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

    skills       StudentSkill[]
    coursesTaken CourseTaken[]
    certificates Certificate[]
    applications Application[]

    @@index([universityId])
}

model Company {
    id          String    @id @default(ulid())
    name        String
    industry    String?
    description String?
    website     String?
    logoUrl     String?
    status      String    @default("pending")
    verifiedAt  DateTime?
    created_at  DateTime  @default(now())
    updated_at  DateTime  @updatedAt

    members CompanyMember[]
    jobs    Job[]

    @@index([status])
    }

model CompanyMember {
    id         String   @id @default(ulid())
    userId     String   @unique
    companyId  String
    position   String   @default("hrd")
    created_at DateTime @default(now())

    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    @@index([companyId])
}

model Skill {
    id         String   @id @default(ulid())
    name       String   @unique
    category   String?
    created_at DateTime @default(now())

    studentSkills StudentSkill[]
    jobSkills     JobSkill[]
    courseSkills  CourseSkill[]
    onlineSkills  OnlineCourseSkill[]
    certSkills    CertificateSkill[]
}

model StudentSkill {
    id         String   @id @default(ulid())
    studentId  String
    skillId    String
    source     String   @default("manual")
    created_at DateTime @default(now())

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
    skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

    @@unique([studentId, skillId])
    @@index([skillId])
}

model Course {
    id           String   @id @default(ulid())
    universityId String?
    code         String?
    name         String   @unique
    sks          Int?
    semester     Int?
    rps          String?
    created_at   DateTime @default(now())
    updated_at   DateTime @updatedAt

    university University?    @relation(fields: [universityId], references: [id], onDelete: SetNull)
    skills     CourseSkill[]
    takenBy    CourseTaken[]
    clos       CLO[]

    @@index([universityId])
}

model CourseSkill {
    id       String @id @default(ulid())
    courseId String
    skillId  String

    course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
    skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

    @@unique([courseId, skillId])
    @@index([skillId])
}

model CourseTaken {
    id         String   @id @default(ulid())
    studentId  String
    courseId   String
    score      Float?
    grade      String?
    semester   Int?
    created_at DateTime @default(now())

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
    course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

    @@unique([studentId, courseId])
    @@index([courseId])
}

model CLO {
    id             String   @id @default(ulid())
    courseId       String
    code           String?  // mis. "CLO 1"
    text           String   // clo_text (rincian capaian+indikator+materi)
    paraphrase     String?  // clo_paraphrase (ringkasan)
    embedding      String?  // vektor 1024-dim disimpan sebagai JSON string
    created_at     DateTime @default(now())

    course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

    @@index([courseId])
}

model OnlineCourse {
    id          String   @id @default(ulid())
    title       String
    provider    String?
    url         String?
    level       String?
    description String?
    created_at  DateTime @default(now())

    skills OnlineCourseSkill[]
}

model OnlineCourseSkill {
    id             String @id @default(ulid())
    onlineCourseId String
    skillId        String

    onlineCourse OnlineCourse @relation(fields: [onlineCourseId], references: [id], onDelete: Cascade)
    skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

    @@unique([onlineCourseId, skillId])
    @@index([skillId])
}

model Job {
    id          String   @id @default(ulid())
    companyId   String
    postedById  String?
    title       String
    description String?
    location    String?
    type        String   @default("fulltime")
    status      String   @default("active")
    salaryMin   Int?
    salaryMax   Int?
    created_at  DateTime @default(now())
    updated_at  DateTime @updatedAt

    company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
    postedBy User?   @relation("JobPostedBy", fields: [postedById], references: [id], onDelete: SetNull)

    skills       JobSkill[]
    applications Application[]

    @@index([companyId])
    @@index([status])
}

model JobSkill {
    id      String @id @default(ulid())
    jobId   String
    skillId String
    weight  Int    @default(1)

    job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
    skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

    @@unique([jobId, skillId])
    @@index([skillId])
}

model Application {
    id            String   @id @default(ulid())
    jobId         String
    studentId     String
    status        String   @default("submitted")
    coverLetter   String?
    matchSnapshot Int?
    created_at    DateTime @default(now())
    updated_at    DateTime @updatedAt

    job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    @@unique([jobId, studentId])
    @@index([studentId])
    @@index([status])
}

model Certificate {
    id           String    @id @default(ulid())
    studentId    String
    title        String
    issuer       String?
    fileUrl      String?
    fileType     String?
    status       String    @default("pending")
    reviewedById String?
    reviewedAt   DateTime?
    note         String?
    created_at   DateTime  @default(now())
    updated_at   DateTime  @updatedAt

    student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
    reviewedBy User?   @relation("CertReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

    skills CertificateSkill[]

    @@index([studentId])
    @@index([status])
}

model CertificateSkill {
    id            String @id @default(ulid())
    certificateId String
    skillId       String

    certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
    skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

    @@unique([certificateId, skillId])
    @@index([skillId])
}

model Notification {
    id         String   @id @default(ulid())
    userId     String
    title      String
    message    String?
    type       String   @default("info")
    isRead     Boolean  @default(false)
    created_at DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([isRead])
}