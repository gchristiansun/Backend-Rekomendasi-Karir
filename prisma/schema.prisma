generator client {
    provider = "prisma-client-js"
}

generator erd {
    provider = "prisma-erd-generator"
  }

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id            String   @id @default(ulid())
    email         String   @unique
    name          String?
    phone         String?
    password      String?
    role          String   @default("student")
    status        String   @default("active")
    refresh_token String?
    recoveryEmail           String?
    recoveryEmailVerifiedAt DateTime?
    created_at    DateTime @default(now())
    updated_at    DateTime @updatedAt

    student          Student?
    companyMember    CompanyMember?
    universityMember UniversityMember?
    notifications    Notification[]
    reviewedCerts    Certificate[]     @relation("CertReviewer")
    postedJobs       Job[]             @relation("JobPostedBy")
    invitationsSent JobInvitation[] @relation("InvitationSentBy")
    passwordResets   PasswordResetToken[]
    recoveryTokens RecoveryEmailToken[]
    
    

    @@index([role])
    @@index([status])
}

model University {
    id         String   @id @default(ulid())
    name       String
    code       String   @unique
    address    String?
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    members  UniversityMember[]
    students Student[]
    subjects Subject[]
}

model UniversityMember {
    id           String   @id @default(ulid())
    userId       String   @unique
    universityId String
    position     String   @default("admin_kampus")
    created_at   DateTime @default(now())

    user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

    @@index([universityId])
}

model Student {
    id           String   @id @default(ulid())
    userId       String   @unique
    universityId String?
    nim          String?  @unique
    major        String?
    semester     Int?
    gpa          Float?
    bio          String?
    faculty     String?     // fakultas
    entryYear   Int?        // angkatan
    graduatedAt DateTime?   // penanda kelulusan
    created_at   DateTime @default(now())
    updated_at   DateTime @updatedAt
    

    user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    university University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

    skills       StudentSkill[]
    subjectsTaken SubjectTaken[]
    certificates Certificate[]
    applications Application[]
    favorites    JobFavorite[]
    cloGrades CLOGrade[]
    jobViews     JobView[]
    invitations JobInvitation[]

    @@index([universityId])
}

model Company {
  id            String    @id @default(ulid())
  name          String
  industry      String?
  description   String?
  website       String?
  logoUrl       String?
  size          String?   // ukuran perusahaan (mis. "51–200 Karyawan")
  address       String?   // alamat kantor pusat
  nib           String?   @unique // Nomor Induk Berusaha (13 digit)
  izinUsahaUrl  String?   // dokumen izin usaha (PDF) di Supabase
  suratResmiUrl String?   // surat resmi perusahaan (opsional)
  status        String    @default("pending")
  verifiedAt    DateTime?
  rejectionReason String?
  rejectedAt      DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  members CompanyMember[]
  jobs    Job[]

  @@index([status])
}

model CompanyMember {
    id         String   @id @default(ulid())
    userId     String   @unique
    companyId  String
    position   String   @default("hrd")
    created_at DateTime @default(now())

    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    @@index([companyId])
}

model Skill {
    id         String   @id @default(ulid())
    name       String   @unique
    category   String?
    created_at DateTime @default(now())

    studentSkills StudentSkill[]
    jobSkills     JobSkill[]
    subjectSkills SubjectSkill[]
    onlineSkills  OnlineCourseSkill[]
    certSkills    CertificateSkill[]
}

model StudentSkill {
    id         String   @id @default(ulid())
    studentId  String
    skillId    String
    source     String   @default("manual")
    created_at DateTime @default(now())

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
    skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

    @@unique([studentId, skillId])
    @@index([skillId])
}

model Subject {
    id           String   @id @default(ulid())
    universityId String?
    code         String?
    name         String   @unique
    sks          Int?
    semester     Int?
    rps          String?
    created_at   DateTime @default(now())
    updated_at   DateTime @updatedAt

    university University?    @relation(fields: [universityId], references: [id], onDelete: SetNull)
    skills     SubjectSkill[]
    takenBy    SubjectTaken[]
    clos       CLO[]

    @@index([universityId])
}

model SubjectSkill {
    id        String @id @default(ulid())
    subjectId String
    skillId   String

    subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
    skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

    @@unique([subjectId, skillId])
    @@index([skillId])
}

model SubjectTaken {
    id         String   @id @default(ulid())
    studentId  String
    subjectId  String
    score      Float?
    grade      String?
    semester   Int?
    created_at DateTime @default(now())

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
    subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

    @@unique([studentId, subjectId])
    @@index([subjectId])
}

model CLO {
    id         String   @id @default(ulid())
    subjectId  String
    code       String?
    text       String
    paraphrase String?
    embedding  String?
    weight Int?
    skills String?  
    
    created_at DateTime @default(now())

    subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
    grades CLOGrade[]
    @@index([subjectId])
}

model OnlineCourse {
    id          String   @id @default(ulid())
    title       String
    provider    String?
    url         String?
    level       String?
    description String?
    created_at  DateTime @default(now())

    skills OnlineCourseSkill[]
}

model OnlineCourseSkill {
    id             String @id @default(ulid())
    onlineCourseId String
    skillId        String

    onlineCourse OnlineCourse @relation(fields: [onlineCourseId], references: [id], onDelete: Cascade)
    skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

    @@unique([onlineCourseId, skillId])
    @@index([skillId])
}

model Job {
  id          String   @id @default(ulid())
  companyId   String
  postedById  String?
  title       String   // nama posisi
  department  String?  // departemen (Technology, Finance, ...)
  description String?  // opsional (digantikan detail persyaratan)
  location    String?
  type        String   @default("fulltime")
  status      String   @default("active")
  salaryMin   Int?
  salaryMax   Int?
  postingDate DateTime? // tanggal mulai lowongan ditayangkan
  deadline    DateTime? // batas akhir menerima lamaran
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedBy User?   @relation("JobPostedBy", fields: [postedById], references: [id], onDelete: SetNull)

  skills       JobSkill[]       // untuk mesin matching rule-based (diisi otomatis)
  requirements JobRequirement[] // detail persyaratan (display + unit embedding semantik)
  applications Application[]
  favorites    JobFavorite[]
  views        JobView[]
  invitations JobInvitation[]

  @@index([companyId])
  @@index([status])
}

model JobSkill {
    id      String @id @default(ulid())
    jobId   String
    skillId String
    weight  Int    @default(1)

    job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
    skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

    @@unique([jobId, skillId])
    @@index([skillId])
}

// ----------------------------------------------------------------------------
// SINYAL PERILAKU MAHASISWA (implicit feedback untuk model pemeringkatan)
// ----------------------------------------------------------------------------

// Favorit / basket: mahasiswa menyimpan lowongan.
model JobFavorite {
  id         String   @id @default(ulid())
  studentId  String
  jobId      String
  created_at DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([studentId, jobId])
  @@index([jobId])
}

// Log tampilan + durasi. Satu baris = satu kunjungan (event log, bukan counter),
// supaya urutan waktu & durasi per kunjungan tidak hilang untuk pelatihan model.
model JobView {
  id         String   @id @default(ulid())
  studentId  String
  jobId      String
  source     String   @default("detail") // detail | list | search | recommendation
  durationMs Int?     // diisi saat mahasiswa meninggalkan halaman
  created_at DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([studentId, jobId])
  @@index([jobId])
  @@index([created_at])
}

// ----------------------------------------------------------------------------
// DETAIL PERSYARATAN LOWONGAN
// Satu baris = satu tanggung jawab; keahlian digabung koma di satu kolom.
// Contoh skills: "Node.js,Express,PostgreSQL"
// embedding: vektor requirement (JSON string) - diisi AI service nanti,
//            untuk pencocokan semantik dengan CLO mahasiswa.
// ----------------------------------------------------------------------------
model JobRequirement {
  id          String  @id @default(ulid())
  jobId       String
  requirement String  // teks tanggung jawab
  skills      String  // keahlian dipisah delimiter ","
  order       Int     @default(0)
  embedding   String? // vektor 1024-dim (JSON) - nanti dari model yang sama dgn CLO

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Application {
    id            String   @id @default(ulid())
    jobId         String
    studentId     String
    status        String   @default("submitted")
    coverLetter   String?
    matchSnapshot Int?
    hiddenFromRecommendation Boolean @default(false)
    created_at    DateTime @default(now())
    updated_at    DateTime @updatedAt

    job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    @@unique([jobId, studentId])
    @@index([studentId])
    @@index([status])
}

model Certificate {
    id           String    @id @default(ulid())
    studentId    String
    title        String
    issuer       String?
    fileUrl      String?
    fileType     String?
    status       String    @default("pending")
    reviewedById String?
    reviewedAt   DateTime?
    note         String?
    created_at   DateTime  @default(now())
    updated_at   DateTime  @updatedAt

    student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
    reviewedBy User?   @relation("CertReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

    skills CertificateSkill[]

    @@index([studentId])
    @@index([status])
}

model CertificateSkill {
    id            String @id @default(ulid())
    certificateId String
    skillId       String

    certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
    skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

    @@unique([certificateId, skillId])
    @@index([skillId])
}

model Notification {
    id         String   @id @default(ulid())
    userId     String
    title      String
    message    String?
    type       String   @default("info")
    isRead     Boolean  @default(false)
    created_at DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([isRead])
}

// ----------------------------------------------------------------------------
// TOKEN RESET PASSWORD (lupa kata sandi)
// Token disimpan sebagai HASH (bukan mentah) demi keamanan.
// ----------------------------------------------------------------------------
model PasswordResetToken {
  id         String    @id @default(ulid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------------------------
// TOKEN VERIFIKASI EMAIL PEMULIHAN
// email: alamat yang SEDANG diverifikasi (dibawa di token, bukan cuma di User,
// supaya kalau user ganti alamat sebelum klik, token lama tidak mengesahkan
// alamat yang salah).
// ----------------------------------------------------------------------------
model RecoveryEmailToken {
  id         String    @id @default(ulid())
  userId     String
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------------------------
// UNDANGAN MELAMAR (perusahaan merekrut kandidat lebih dulu)
// Mahasiswa yang menerima undangan -> otomatis menjadi Application.
// ----------------------------------------------------------------------------
model JobInvitation {
  id          String    @id @default(ulid())
  jobId       String
  studentId   String
  invitedById String?
  message     String?
  status      String    @default("pending") // pending | accepted | declined | cancelled
  respondedAt DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("InvitationSentBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([jobId, studentId])
  @@index([studentId])
  @@index([jobId])
}

// ----------------------------------------------------------------------------
// NILAI PER CAPAIAN PEMBELAJARAN (CLO)
// Nilai akhir mata kuliah dihitung dari nilai-nilai ini menurut bobot CLO,
// lalu disimpan ke SubjectTaken agar mesin OBE lama tetap berjalan.
// ----------------------------------------------------------------------------
model CLOGrade {
  id         String   @id @default(ulid())
  studentId  String
  cloId      String
  score      Float
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  clo     CLO     @relation(fields: [cloId], references: [id], onDelete: Cascade)

  @@unique([studentId, cloId])
  @@index([cloId])
}