# PORT BE
PORT=5000

# DATABSE URL
DATABASE_URL=

NODE_ENV=development

# Daftar origin frontend yang boleh memanggil API, dipisah koma (tanpa spasi).
# Contoh: http://localhost:5173,https://namaapp.vercel.app
FRONTEND_URL=http://localhost:5173

# Izinkan URL pratinjau Vercel (*.vercel.app) yang subdomainnya berganti
# setiap kali ada push. Isi "true" hanya bila memang dibutuhkan.
ALLOW_VERCEL_PREVIEW=false

# Setel "true" bila frontend dan backend berbeda situs (mis. frontend di Vercel,
# backend lokal lewat ngrok). Cookie refresh token akan memakai
# SameSite=None; Secure supaya tetap terkirim lintas situs.
CROSS_SITE_COOKIE=false

# ENV AUTH
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=60d
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=1d

# SUPABASE
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=certificates
SUPABASE_COMPANY_BUCKET=company-documents
SUPABASE_LOGO_BUCKET=company-logos

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sistem Rekomendasi Karir <noreply@example.com>"

# Model AI Service
AI_SERVICE_URL=http://localhost:8000
